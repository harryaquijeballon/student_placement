#!/usr/bin/env bash
# Git pre-commit hook: refuse a commit that would put personal data or an
# unexpected file into this public repo.
# Install once from the repo root:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# The checker and its fixtures hold deliberately bad examples, so skip them
# in the privacy scan. They are still covered by the allowlist.
to_scan=$(echo "$staged" | grep -v '^scripts/' || true)

if [ -n "$to_scan" ]; then
  # shellcheck disable=SC2086
  Rscript scripts/check_site.R privacy $to_scan
fi
# shellcheck disable=SC2086
Rscript scripts/check_site.R allowlist $staged
